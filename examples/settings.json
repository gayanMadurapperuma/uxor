{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "codegraph hook edited",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "codegraph hook prompt",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
